{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purple-buzz/cta-banner",
	"title": "CTA Banner",
	"category": "design",
	"icon": "megaphone",
	"description": "Full width call to action banner with icon, heading, text and button.",
	"keywords": [ "cta", "banner", "button", "call to action" ],
	"textdomain": "purple-buzz",
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Great transformations successful"
		},
		"text": {
			"type": "string",
			"default": "Quis ipsum suspendisse ultrices gravida."
		},
		"icon": {
			"type": "string",
			"default": "bxs-box"
		},
		"buttonLabel": {
			"type": "string",
			"default": "View Our Work"
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"reusable": true
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
